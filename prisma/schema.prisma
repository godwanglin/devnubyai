// Devnuby AI — PostgreSQL 16 schema.
// Design doc: .plans/01-database-schema.md
//
// Some DB rules cannot be expressed in PSL and live only in the SQL migrations:
// CHECK constraints, and the partial unique index on gateways(is_primary)
// (WHERE is_primary = true). Write new migrations with `prisma migrate diff`
// and review them by hand before `prisma migrate deploy`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Users & auth ─────────────

model Plan {
  id                 BigInt   @id @default(autoincrement()) 
  slug               String   @unique(map: "uq_plans_slug") @db.VarChar(32)
  name               String   @db.VarChar(80)
  description        String?  @db.VarChar(255)
  priceMonthly       Int      @default(0) @map("price_monthly") 
  priceYearly        Int      @default(0) @map("price_yearly") 
  currency           String   @default("IDR") @db.VarChar(8)
  discountMonthlyType  String?  @map("discount_monthly_type") @db.VarChar(16)
  discountMonthlyValue Int?     @map("discount_monthly_value") 
  discountYearlyType   String?  @map("discount_yearly_type") @db.VarChar(16)
  discountYearlyValue  Int?     @map("discount_yearly_value") 
  // Spend caps in USD per window; null or 0 means no limit for that window
  monthlyCostLimitUsd  Decimal? @map("monthly_cost_limit_usd") @db.Decimal(12, 4)
  weeklyCostLimitUsd   Decimal? @map("weekly_cost_limit_usd") @db.Decimal(12, 4)
  fiveHourCostLimitUsd Decimal? @map("five_hour_cost_limit_usd") @db.Decimal(12, 4)
  dailyRequestLimit  Int?     @map("daily_request_limit") 
  requestsPerMinute  Int?     @map("requests_per_minute") 
  dailyUploadLimitMb      Int?     @map("daily_upload_limit_mb")
  dailyAgentUploadLimitMb Int?     @map("daily_agent_upload_limit_mb")
  // Concurrent generations per user; null/0 = default (3)
  maxParallelRequests     Int?     @map("max_parallel_requests")
  badge              String?  @db.VarChar(32)
  features           Json?
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(100) @map("sort_order") 
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  users         User[]
  modelAccesses PlanModelAccess[]

  @@index([isActive, sortOrder], map: "idx_plans_listing")
  @@map("plans")
}

model User {
  id          BigInt    @id @default(autoincrement()) 
  publicId    String    @unique(map: "uq_users_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  email       String    @unique(map: "uq_users_email") @db.VarChar(320)
  name        String    @db.VarChar(120)
  phone       String?   @db.VarChar(32)
  avatarUrl   String?   @map("avatar_url") @db.VarChar(2048)
  role        String    @default("user") @db.VarChar(16)
  status      String    @default("active") @db.VarChar(16)
  statusReason String?  @map("status_reason") @db.VarChar(500)
  planId      BigInt?   @map("plan_id")
  // null = no expiry (free plan, admin-granted or pre-expiry purchases)
  planExpiresAt DateTime? @map("plan_expires_at") @db.Timestamptz(3)
  chatPinHash  String?   @map("chat_pin_hash") @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan             Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull, map: "fk_users_plan")
  authAccounts     AuthAccount[]
  authSessions     AuthSession[]
  chatSessions     ChatSession[]
  sessionFiles     SessionFile[]
  usagePeriods     UserUsagePeriod[]
  usageLogs        UsageLog[]
  usageWindows     UserUsageWindow[]
  updatedSettings  AppSetting[]
  adminAuditLogs   AdminAuditLog[]
  transactions     PaymentTransaction[]
  manualUpdatedTrans PaymentTransaction[] @relation("ManualTransactionUpdater")
  userNotes        UserNote[]
  memorySettings   UserMemorySettings?
  preferences      UserPreference?
  homeSuggestions  UserHomeSuggestion[]
  projects         Project[]
  projectFiles     ProjectFile[]

  @@index([planId], map: "idx_users_plan")
  @@index([role, status], map: "idx_users_role_status")
  @@map("users")
}

model AuthAccount {
  id                BigInt   @id @default(autoincrement()) 
  userId            BigInt   @map("user_id") 
  provider          String   @db.VarChar(32)
  providerAccountId String   @map("provider_account_id") @db.VarChar(191)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_auth_accounts_user")

  @@unique([provider, providerAccountId], map: "uq_auth_accounts_provider")
  @@index([userId], map: "idx_auth_accounts_user")
  @@map("auth_accounts")
}

model AuthSession {
  id        BigInt   @id @default(autoincrement()) 
  userId    BigInt   @map("user_id") 
  tokenHash Bytes    @unique(map: "uq_auth_sessions_token") @map("token_hash") @db.ByteA
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  location  String?  @map("location") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_auth_sessions_user")

  @@index([userId], map: "idx_auth_sessions_user")
  @@index([expiresAt], map: "idx_auth_sessions_expires")
  @@map("auth_sessions")
}

// ───────────── Gateways & upstream catalog ─────────────

model Gateway {
  id                  BigInt    @id @default(autoincrement()) 
  slug                String    @unique(map: "uq_gateways_slug") @db.VarChar(64)
  name                String    @db.VarChar(120)
  baseUrl             String    @map("base_url") @db.VarChar(2048)
  wireApi             String    @default("chat") @map("wire_api") @db.VarChar(16)
  modelsPath          String    @default("/models") @map("models_path") @db.VarChar(255)
  apiKeyCiphertext    Bytes     @map("api_key_ciphertext") @db.ByteA
  apiKeyLast4         String?   @map("api_key_last4") @db.Char(4)
  extraHeaders        Json?     @map("extra_headers")
  isPrimary           Boolean   @default(false) @map("is_primary")
  /// GENERATED column (IF(is_primary = 1, 1, NULL)) PERSISTENT — read-only, never write it.
  /// Its UNIQUE index guarantees at most one primary gateway.
  primaryMarker       Int?      @unique(map: "uq_gateways_single_primary") @map("primary_marker") @db.SmallInt
  isEnabled           Boolean   @default(true) @map("is_enabled")
  priority            Int       @default(100) 
  timeoutMs           Int       @default(120000) @map("timeout_ms") 
  firstTokenTimeoutMs Int       @default(20000) @map("first_token_timeout_ms") 
  healthStatus        String    @default("unknown") @map("health_status") @db.VarChar(16)
  consecutiveFailures Int       @default(0) @map("consecutive_failures") 
  circuitOpenUntil    DateTime? @map("circuit_open_until") @db.Timestamptz(3)
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastFailureAt       DateTime? @map("last_failure_at") @db.Timestamptz(3)
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(3)
  // "api_key" (static key) or "oauth" (token pool in provider_connections)
  authType            String    @default("api_key") @map("auth_type") @db.VarChar(16)
  // OAuth provider id ("xai", "grok-cli"); one backing gateway per provider
  oauthProvider       String?   @unique(map: "uq_gateways_oauth_provider") @map("oauth_provider") @db.VarChar(32)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  upstreamModels      UpstreamModel[]
  providerConnections ProviderConnection[]

  @@index([isEnabled, isPrimary, priority], map: "idx_gateways_routing")
  @@map("gateways")
}

// One OAuth account of an OAuth-backed gateway; tried in sortOrder, skipped when disabled or cooling down
model ProviderConnection {
  id                     BigInt    @id @default(autoincrement())
  gatewayId              BigInt    @map("gateway_id")
  label                  String?   @db.VarChar(120)
  email                  String?   @db.VarChar(320)
  displayName            String?   @map("display_name") @db.VarChar(160)
  upstreamUserId         String?   @map("upstream_user_id") @db.VarChar(128)
  accessTokenCiphertext  Bytes     @map("access_token_ciphertext") @db.ByteA
  refreshTokenCiphertext Bytes?    @map("refresh_token_ciphertext") @db.ByteA
  idTokenCiphertext      Bytes?    @map("id_token_ciphertext") @db.ByteA
  scope                  String?   @db.VarChar(512)
  expiresAt              DateTime? @map("expires_at") @db.Timestamptz(3)
  providerData           Json?     @map("provider_data")
  quotaCached            Json?     @map("quota_cached")
  quotaCheckedAt         DateTime? @map("quota_checked_at") @db.Timestamptz(3)
  cooldownUntil          DateTime? @map("cooldown_until") @db.Timestamptz(3)
  lastError              String?   @map("last_error") @db.VarChar(500)
  isEnabled              Boolean   @default(true) @map("is_enabled")
  sortOrder              Int       @default(100) @map("sort_order")
  lastUsedAt             DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade, map: "fk_provider_connections_gateway")

  @@index([gatewayId, isEnabled, sortOrder], map: "idx_provider_connections_pool")
  @@map("provider_connections")
}

model UpstreamModel {
  id          BigInt   @id @default(autoincrement()) 
  gatewayId   BigInt   @map("gateway_id") 
  modelKey    String   @map("model_key") @db.VarChar(191)
  ownedBy     String?  @map("owned_by") @db.VarChar(120)
  isAvailable Boolean  @default(true) @map("is_available")
  rawMetadata Json?    @map("raw_metadata")
  firstSeenAt DateTime @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  gateway Gateway             @relation(fields: [gatewayId], references: [id], onDelete: Cascade, map: "fk_upstream_models_gateway")
  routes  CatalogModelRoute[]

  @@unique([gatewayId, modelKey], map: "uq_upstream_models_gateway_key")
  @@index([gatewayId, isAvailable, modelKey], map: "idx_upstream_models_gateway_avail")
  @@index([modelKey], map: "idx_upstream_models_key")
  @@map("upstream_models")
}

// ───────────── Public catalog ─────────────

model ModelProvider {
  id        BigInt   @id @default(autoincrement()) 
  slug      String   @unique(map: "uq_model_providers_slug") @db.VarChar(32)
  name      String   @db.VarChar(80)
  logoKey   String   @map("logo_key") @db.VarChar(64)
  logoUrl   String?  @map("logo_url") @db.VarChar(2048)
  sortOrder Int      @default(100) @map("sort_order") 
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  catalogModels CatalogModel[]

  @@map("model_providers")
}

model CatalogModel {
  id                BigInt   @id @default(autoincrement()) 
  publicId          String   @unique(map: "uq_catalog_models_public_id") @map("public_id") @db.VarChar(128)
  displayName       String   @map("display_name") @db.VarChar(120)
  shortName         String   @map("short_name") @db.VarChar(60)
  description       String?  @db.VarChar(500)
  providerId        BigInt   @map("provider_id") 
  category          String   @default("powerful") @db.VarChar(16)
  badge             String?  @db.VarChar(32)
  contextWindow     Int?     @map("context_window") 
  maxOutputTokens   Int?     @map("max_output_tokens") 
  supportsVision    Boolean  @default(false) @map("supports_vision")
  supportsTools     Boolean  @default(false) @map("supports_tools")
  supportsReasoning Boolean  @default(false) @map("supports_reasoning")
  status            String   @default("draft") @db.VarChar(16)
  sortOrder         Int      @default(100) @map("sort_order") 

  inputPricePerMillion  Decimal  @default(0.0000) @map("input_price_per_million") @db.Decimal(10, 4)
  outputPricePerMillion Decimal  @default(0.0000) @map("output_price_per_million") @db.Decimal(10, 4)
  pricingCurrency       String   @default("USD") @map("pricing_currency") @db.VarChar(8)

  routingStrategy      String @default("priority") @map("routing_strategy") @db.VarChar(16)
  routeCooldownSeconds Int    @default(30) @map("route_cooldown_seconds")

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider     ModelProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict, map: "fk_catalog_models_provider")
  routes       CatalogModelRoute[]
  chatSessions ChatSession[]
  chatMessages ChatMessage[]
  planAccesses PlanModelAccess[]
  usageLogs    UsageLog[]

  @@index([status, sortOrder], map: "idx_catalog_models_listing")
  @@index([providerId], map: "idx_catalog_models_provider")
  @@map("catalog_models")
}

model PlanModelAccess {
  id             BigInt       @id @default(autoincrement()) 
  planId         BigInt       @map("plan_id") 
  catalogModelId BigInt       @map("catalog_model_id") 
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Cascade, map: "fk_pma_plan")
  catalogModel CatalogModel @relation(fields: [catalogModelId], references: [id], onDelete: Cascade, map: "fk_pma_model")

  @@unique([planId, catalogModelId], map: "uq_plan_model_access")
  @@index([catalogModelId], map: "idx_pma_model")
  @@map("plan_model_accesses")
}

model CatalogModelRoute {
  id              BigInt   @id @default(autoincrement()) 
  catalogModelId  BigInt   @map("catalog_model_id") 
  upstreamModelId BigInt   @map("upstream_model_id") 
  priority        Int
  weight          Int      @default(1)
  isEnabled       Boolean  @default(true) @map("is_enabled")
  paramOverrides  Json?    @map("param_overrides")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  catalogModel  CatalogModel  @relation(fields: [catalogModelId], references: [id], onDelete: Cascade, map: "fk_routes_catalog_model")
  upstreamModel UpstreamModel @relation(fields: [upstreamModelId], references: [id], onDelete: Cascade, map: "fk_routes_upstream_model")

  @@unique([catalogModelId, upstreamModelId], map: "uq_routes_model_upstream")
  @@index([catalogModelId, isEnabled, priority], map: "idx_routes_resolve")
  @@index([upstreamModelId], map: "idx_routes_upstream")
  @@map("catalog_model_routes")
}

model AppSetting {
  settingKey String   @id @map("setting_key") @db.VarChar(64)
  value      Json
  updatedBy  BigInt?  @map("updated_by") 
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull, map: "fk_app_settings_user")

  @@index([updatedBy], map: "idx_app_settings_updated_by")
  @@map("app_settings")
}

/// Admin-managed system prompts; active ones are joined by sortOrder and sent
/// first on every chat request, with {placeholders} filled per request.
model SystemPrompt {
  id        BigInt   @id @default(autoincrement()) 
  publicId  String   @unique(map: "uq_system_prompts_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  name      String   @db.VarChar(120)
  content   String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(100) @map("sort_order") 
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder], map: "idx_system_prompts_active")
  @@map("system_prompts")
}

// ───────────── Chat ─────────────

model ChatSession {
  id             BigInt    @id @default(autoincrement()) 
  /// UUIDv7 used in the URL: /c/[uuid]
  publicId       String    @unique(map: "uq_chat_sessions_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  userId         BigInt    @map("user_id") 
  title          String    @default("New chat") @db.VarChar(200)
  catalogModelId BigInt?   @map("catalog_model_id") 
  projectId      BigInt?   @map("project_id")
  isLocked       Boolean   @default(false) @map("is_locked")
  pinCodeHash    String?   @map("pin_code_hash") @db.VarChar(128)
  isPinned       Boolean   @default(false) @map("is_pinned")
  isArchived     Boolean   @default(false) @map("is_archived")
  shareToken     String?   @unique(map: "uq_chat_sessions_share_token") @map("share_token") @db.Char(36)
  sharedAt       DateTime? @map("shared_at") @db.Timestamptz(3)
  lastMessageAt  DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_chat_sessions_user")
  catalogModel CatalogModel? @relation(fields: [catalogModelId], references: [id], onDelete: SetNull, map: "fk_chat_sessions_model")
  messages     ChatMessage[]
  files        SessionFile[]
  notes        UserNote[]
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull, map: "fk_chat_sessions_project")

  @@index([projectId, isPinned(sort: Desc), lastMessageAt(sort: Desc)], map: "idx_chat_sessions_project")

  @@index([userId, isPinned(sort: Desc), lastMessageAt(sort: Desc), id(sort: Desc)], map: "idx_chat_sessions_sidebar")
  @@index([userId, isArchived, lastMessageAt(sort: Desc), id(sort: Desc)], map: "idx_chat_sessions_archived")
  @@index([catalogModelId], map: "idx_chat_sessions_model")
  @@map("chat_sessions")
}

model ChatMessage {
  id               BigInt   @id @default(autoincrement()) 
  publicId         String   @unique(map: "uq_chat_messages_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  sessionId        BigInt   @map("session_id") 
  role             String   @db.VarChar(16)
  content          String   @db.Text
  reasoning        String?  @db.Text
  parts            Json?
  catalogModelId   BigInt?  @map("catalog_model_id") 
  status           String   @default("completed") @db.VarChar(16)
  errorCode        String?  @map("error_code") @db.VarChar(64)
  /// The real error (message + stack) behind a failed turn. Never sent to the client;
  /// admins look it up in the logs panel. The user only sees the friendly `content`.
  errorDetail      String?  @map("error_detail") @db.Text
  /// Request id of a failed turn, shown on the user's error card and searched by admins.
  requestId        String?  @map("request_id") @db.VarChar(64)
  promptTokens     Int?     @map("prompt_tokens") 
  completionTokens Int?     @map("completion_tokens") 
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session      ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_chat_messages_session")
  catalogModel CatalogModel? @relation(fields: [catalogModelId], references: [id], onDelete: SetNull, map: "fk_chat_messages_model")
  files        SessionFile[]

  @@index([sessionId, id], map: "idx_chat_messages_session")
  // Full-text search index for `search_past_chats` (GIN on to_tsvector('simple', content))
  // is created by prisma/migrations/20261106000000_add_chat_message_search; db push leaves it alone.
  @@index([status, updatedAt], map: "idx_chat_messages_status")
  @@index([catalogModelId], map: "idx_chat_messages_model")
  @@map("chat_messages")
}

model SessionFile {
  id         BigInt   @id @default(autoincrement()) 
  publicId   String   @unique(map: "uq_session_files_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  userId     BigInt   @map("user_id") 
  sessionId  BigInt   @map("session_id") 
  messageId  BigInt?  @map("message_id") 
  filename   String   @db.VarChar(128)
  storageKey String   @unique(map: "uq_session_files_storage_key") @map("storage_key") @db.VarChar(512)
  mimeType   String   @map("mime_type") @db.VarChar(127)
  sizeBytes  BigInt   @map("size_bytes") 
  source     String   @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_session_files_user")
  session ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_session_files_session")
  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull, map: "fk_session_files_message")

  @@unique([sessionId, filename], map: "uq_session_files_name")
  @@index([userId, createdAt], map: "idx_session_files_user")
  @@index([messageId], map: "idx_session_files_message")
  @@map("session_files")
}

// ───────────── Observability & quota ─────────────

model UserUsagePeriod {
  userId           BigInt   @map("user_id") 
  periodStart      DateTime @map("period_start") @db.Date
  requestCount     Int      @default(0) @map("request_count") 
  promptTokens     BigInt   @default(0) @map("prompt_tokens") 
  completionTokens BigInt   @default(0) @map("completion_tokens") 
  costUsd          Decimal  @default(0) @map("cost_usd") @db.Decimal(16, 8)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_usage_user")

  @@id([userId, periodStart])
  @@map("user_usage_periods")
}

model UserUsageWindow {
  id               BigInt   @id @default(autoincrement()) 
  userId           BigInt   @map("user_id") 
  windowType       String   @map("window_type") @db.VarChar(16)
  windowKey        String   @map("window_key") @db.VarChar(32)
  windowStart      DateTime @map("window_start") @db.Timestamptz(3)
  windowEnd        DateTime @map("window_end") @db.Timestamptz(3)
  requestCount     Int      @default(0) @map("request_count") 
  promptTokens     BigInt   @default(0) @map("prompt_tokens") 
  completionTokens BigInt   @default(0) @map("completion_tokens") 
  costUsd          Decimal  @default(0) @map("cost_usd") @db.Decimal(16, 8)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_usage_window_user")

  @@unique([userId, windowType, windowKey], map: "uq_user_window")
  @@index([userId, windowType, windowEnd], map: "idx_user_window_lookup")
  @@map("user_usage_windows")
}

/// One row per generated reply: who spent what, on which model, at which price.
/// Prices are snapshotted so later catalog edits never rewrite history.
model UsageLog {
  id                    BigInt   @id @default(autoincrement())
  userId                BigInt   @map("user_id")
  sessionId             BigInt?  @map("session_id")
  messageId             BigInt?  @map("message_id")
  catalogModelId        BigInt?  @map("catalog_model_id")
  requestId             String?  @map("request_id") @db.VarChar(64)
  promptTokens          Int      @default(0) @map("prompt_tokens")
  completionTokens      Int      @default(0) @map("completion_tokens")
  inputPricePerMillion  Decimal  @default(0) @map("input_price_per_million") @db.Decimal(10, 4)
  outputPricePerMillion Decimal  @default(0) @map("output_price_per_million") @db.Decimal(10, 4)
  costUsd               Decimal  @default(0) @map("cost_usd") @db.Decimal(16, 8)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_usage_logs_user")
  catalogModel CatalogModel? @relation(fields: [catalogModelId], references: [id], onDelete: SetNull, map: "fk_usage_logs_model")

  @@index([userId, createdAt(sort: Desc)], map: "idx_usage_logs_user")
  @@index([catalogModelId, createdAt], map: "idx_usage_logs_model")
  @@map("usage_logs")
}

model AdminAuditLog {
  id          BigInt   @id @default(autoincrement()) 
  actorUserId BigInt?  @map("actor_user_id") 
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(32)
  entityId    String?  @map("entity_id") @db.VarChar(128)
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, map: "fk_audit_actor")

  @@index([entityType, entityId, createdAt], map: "idx_audit_entity")
  @@index([actorUserId, createdAt], map: "idx_audit_actor")
  @@index([createdAt], map: "idx_audit_created")
  @@map("admin_audit_logs")
}

// ───────────── Payments & transactions ─────────────

model PaymentMethod {
  id           BigInt   @id @default(autoincrement()) 
  publicId     String   @unique(map: "uq_payment_methods_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  name         String   @db.VarChar(120)
  code         String   @unique(map: "uq_payment_methods_code") @db.VarChar(64)
  category     String   @default("virtual_account") @db.VarChar(32)
  provider     String   @default("doku") @db.VarChar(16)
  dokuCode     String?  @map("doku_code") @db.VarChar(64)
  flowType     String   @default("direct") @map("flow_type") @db.VarChar(16)
  imagePath    String?  @map("image_path") @db.VarChar(512)
  description  String?  @db.VarChar(255)
  instructions String?  @db.Text
  minAmount             Int      @default(1000) @map("min_amount")
  maxAmount             Int?     @map("max_amount")
  expiryDurationMinutes Int      @default(60) @map("expiry_duration_minutes")
  feeType               String   @default("none") @map("fee_type") @db.VarChar(16)
  feeValue              Int      @default(0) @map("fee_value")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(100) @map("sort_order") 
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  transactions PaymentTransaction[]

  @@index([isActive, sortOrder], map: "idx_payment_methods_listing")
  @@map("payment_methods")
}

model PaymentTransaction {
  id                 BigInt    @id @default(autoincrement()) 
  publicId           String    @unique(map: "uq_payment_transactions_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  invoiceNumber      String    @unique(map: "uq_payment_transactions_invoice") @map("invoice_number") @db.VarChar(64)
  userId             BigInt?   @map("user_id") 
  paymentMethodId    BigInt?   @map("payment_method_id") 
  paymentMethodCode  String    @map("payment_method_code") @db.VarChar(64)
  paymentMethodName  String    @map("payment_method_name") @db.VarChar(120)
  provider           String    @default("doku") @db.VarChar(16)
  providerReference  String?   @map("provider_reference") @db.VarChar(64)
  amount             Int
  fee                Int       @default(0) 
  totalAmount        Int       @map("total_amount") 
  currency           String    @default("IDR") @db.VarChar(8)
  status             String    @default("PENDING") @db.VarChar(24)
  paymentCode        String?   @map("payment_code") @db.VarChar(128)
  checkoutUrl        String?   @map("checkout_url") @db.VarChar(2048)
  qrContent          String?   @map("qr_content") @db.Text
  howToPayUrl        String?   @map("how_to_pay_url") @db.VarChar(2048)
  customerName       String    @map("customer_name") @db.VarChar(120)
  customerEmail      String    @map("customer_email") @db.VarChar(320)
  customerPhone      String?   @map("customer_phone") @db.VarChar(32)
  metadata           Json?
  gatewayResponse    Json?     @map("doku_response")
  manualNotes        String?   @map("manual_notes") @db.Text
  manualUpdatedBy    BigInt?   @map("manual_updated_by") 
  manualUpdatedAt    DateTime? @map("manual_updated_at") @db.Timestamptz(3)
  paidAt             DateTime? @map("paid_at") @db.Timestamptz(3)
  expiredAt          DateTime? @map("expired_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_transactions_user")
  paymentMethod       PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull, map: "fk_transactions_method")
  manualUpdatedByUser User?          @relation("ManualTransactionUpdater", fields: [manualUpdatedBy], references: [id], onDelete: SetNull, map: "fk_transactions_manual_updater")

  @@index([userId, createdAt], map: "idx_transactions_user")
  @@index([status, createdAt], map: "idx_transactions_status")
  @@index([paymentMethodCode], map: "idx_transactions_method_code")
  @@index([provider, providerReference], map: "idx_transactions_provider_ref")
  @@index([createdAt], map: "idx_transactions_created")
  @@map("payment_transactions")
}

// ───────────── User memory notes (AI tool: memory_note) ─────────────
model UserNote {
  id        BigInt   @id @default(autoincrement()) 
  publicId  String   @unique(map: "uq_user_notes_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  userId    BigInt   @map("user_id") 
  sessionId BigInt?  @map("session_id") 
  title     String   @db.VarChar(200)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_notes_user")
  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull, map: "fk_user_notes_session")

  @@index([userId, updatedAt], map: "idx_user_notes_user_updated")
  @@index([sessionId], map: "idx_user_notes_session")
  @@map("user_notes")
}

/// Memory preferences of a user (Settings → Memory). No row means the defaults.
model UserMemorySettings {
  userId            BigInt   @id @map("user_id")
  /// Saved notes are shown to the model and it may save new ones (`memory_note`)
  memoryEnabled     Boolean  @default(true) @map("memory_enabled")
  /// The model may search the user's earlier chats
  chatSearchEnabled Boolean  @default(false) @map("chat_search_enabled")
  /// Health, religion, politics ... may be saved to memory
  includeSensitive  Boolean  @default(false) @map("include_sensitive")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_memory_settings_user")

  @@map("user_memory_settings")
}

/// Answers from onboarding (#/onboarding/*). Personalizes home quick prompts.
/// No row, or onboardedAt null, means the user has not finished onboarding yet.
model UserPreference {
  userId      BigInt    @id @map("user_id")
  /// One of ONBOARDING_ROLES (developer, student, teacher, ...)
  role        String?   @db.VarChar(32)
  /// string[] of ONBOARDING_INTERESTS ids
  interests   Json?
  onboardedAt DateTime? @map("onboarded_at") @db.Timestamptz(3)
  /// How much of a reply's work the chat shows: verbose | normal | silent (null = normal)
  responseMode String?  @map("response_mode") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_preferences_user")

  @@map("user_preferences")
}

// ───────────── Personalized home page (AI-generated, refreshed every 5h) ─────────────
/// One row per user + UI locale: typewriter headlines and quick prompts generated
/// from the user's recent chat titles. Stale rows are regenerated lazily on read.
model UserHomeSuggestion {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  locale      String   @db.VarChar(8)
  /// string[] (10 items)
  headlines   Json
  /// { id, label, prompt }[] (4 items)
  prompts     Json
  generatedAt DateTime @map("generated_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_home_suggestions_user")

  @@unique([userId, locale], map: "uq_user_home_suggestions_user_locale")
  @@map("user_home_suggestions")
}

// ───────────── Project Workspaces ─────────────
model Project {
  id                  BigInt        @id @default(autoincrement())
  /// UUIDv7 standard with hyphens: /project/[uuid]
  publicId            String        @unique(map: "uq_projects_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  userId              BigInt        @map("user_id")
  name                String        @db.VarChar(120)
  description         String?       @db.Text
  customInstructions  String?       @map("custom_instructions") @db.Text
  isPinned            Boolean       @default(false) @map("is_pinned")
  isArchived          Boolean       @default(false) @map("is_archived")
  shareToken          String?       @unique(map: "uq_projects_share_token") @map("share_token") @db.Char(36)
  sharedAt            DateTime?     @map("shared_at") @db.Timestamptz(3)
  shareAccess         String        @default("invited") @map("share_access") @db.VarChar(16)
  invitedEmails       Json?         @map("invited_emails")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_projects_user")
  chatSessions        ChatSession[]
  projectFiles        ProjectFile[]

  @@index([userId, isPinned(sort: Desc), updatedAt(sort: Desc)], map: "idx_projects_sidebar")
  @@map("projects")
}

model ProjectFile {
  id                  BigInt        @id @default(autoincrement())
  publicId            String        @unique(map: "uq_project_files_public_id") @default(uuid(7)) @map("public_id") @db.Char(36)
  projectId           BigInt        @map("project_id")
  userId              BigInt        @map("user_id")
  filename            String        @db.VarChar(255)
  storageKey          String        @db.VarChar(512)
  mimeType            String        @db.VarChar(128)
  sizeBytes           BigInt        @map("size_bytes")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_project_files_project")
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_project_files_user")

  @@index([projectId, createdAt(sort: Desc)], map: "idx_project_files_project")
  @@map("project_files")
}
